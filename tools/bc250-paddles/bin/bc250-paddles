# Order: --lang, BC250_LANG, the system locale, then English.
detect_language() {
    local candidate code
    for candidate in "${1:-}" "${BC250_LANG:-}" "${LC_ALL:-}" "${LC_MESSAGES:-}" "${LANG:-}"; do
        [ -n "$candidate" ] || continue
        code="${candidate%%.*}"
        code="${code%%_*}"
        case "$code" in
            pl|en) printf '%s' "$code"; return 0 ;;
        esac
    done
    printf 'en'
}

LANGUAGE="$(detect_language "")"

msg() {
    local key="$1"; shift
    local template
    if [ "$LANGUAGE" = "pl" ]; then
        template="${MSG_PL[$key]-$key}"
    else
        template="${MSG_EN[$key]-$key}"
    fi
    # shellcheck disable=SC2059 -- the template comes from our own catalogue
    printf "$template" "$@"
}

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    C_OK=$'\033[32m'; C_WARN=$'\033[33m'; C_BAD=$'\033[31m'
    C_DIM=$'\033[2m'; C_HEAD=$'\033[1m'; C_OFF=$'\033[0m'
else
    C_OK=""; C_WARN=""; C_BAD=""; C_DIM=""; C_HEAD=""; C_OFF=""
fi

die() { printf '%s: %s\n' "$PROGRAM" "$*" >&2; exit 1; }
note() { printf '%s\n' "$*" >&2; }

# ---------------------------------------------------------------------------
# Reading state
# ---------------------------------------------------------------------------

native_installed() { [ -d "${NATIVE_STEAM}/ubuntu12_32" ]; }
flatpak_installed() { [ -d "${FLATPAK_STEAM}/ubuntu12_32" ]; }

# Installations the commands act on: --target, otherwise the detected ones.
targets() {
    case "$TARGET" in
        native|flatpak) printf '%s\n' "$TARGET" ;;
        all) printf 'native\nflatpak\n' ;;
        "")
            native_installed && printf 'native\n'
            flatpak_installed && printf 'flatpak\n'
            ;;
    esac
    return 0
}

steam_dir() {
    if [ "$1" = "native" ]; then printf '%s' "$NATIVE_STEAM"; else printf '%s' "$FLATPAK_STEAM"; fi
}

# The same path with $HOME shortened to ~, for display.
short_path() {
    # shellcheck disable=SC2088  # a literal ~ is the point here
    case "$1" in
        "${HOME}"/*) printf '~/%s' "${1#"${HOME}"/}" ;;
        *) printf '%s' "$1" ;;
    esac
}

# Value of a key inside one [section] of a GKeyFile (the Flatpak override format).
keyfile_get() {
    local file="$1" section="$2" key="$3"
    [ -f "$file" ] || return 0
    awk -v s="[$section]" -v k="$key" '
        /^\[/ { in_s = ($0 == s); next }
        in_s && index($0, k "=") == 1 { print substr($0, length(k) + 2); exit }
    ' "$file"
}

envd_value() {
    [ -f "$ENVD_FILE" ] || return 0
    sed -n "s/^${ENV_NAME}=\"\{0,1\}\([^\"]*\)\"\{0,1\}$/\1/p" "$ENVD_FILE" | head -1
}

override_value() { keyfile_get "$FLATPAK_OVERRIDE" Environment "$ENV_NAME"; }

override_unset_listed() {
    case ";$(keyfile_get "$FLATPAK_OVERRIDE" Context unset-environment);" in
        *";${ENV_NAME};"*) return 0 ;;
    esac
    return 1
}

# Prints one of: ours, foreign, none.
target_state() {
    local value
    if [ "$1" = "native" ]; then value="$(envd_value)"; else value="$(override_value)"; fi
    if [ -z "$value" ]; then
        printf 'none'
    elif [ "$value" = "$MAPPING" ]; then
        printf 'ours'
    else
        printf 'foreign'
    fi
}

# environment.d files are read in lexical order; a later one setting the same
# variable wins over ours.
shadowing_envd_file() {
    local dir file
    dir="$(dirname "$ENVD_FILE")"
    [ -d "$dir" ] || return 0
    for file in "$dir"/*.conf; do
        [ -f "$file" ] || continue
        [ "$file" = "$ENVD_FILE" ] && continue
        [[ "$(basename "$file")" > "$(basename "$ENVD_FILE")" ]] || continue
        grep -q "^${ENV_NAME}=" "$file" && { printf '%s' "$file"; return 0; }
    done
    return 0
}

# Lines "pid kind has-mapping" for every running Steam client process.
running_steam() {
    local dir pid comm kind envfile has env_text
    for dir in "$PROC_DIR"/[0-9]*; do
        [ -r "${dir}/comm" ] || continue
        comm="$(cat "${dir}/comm" 2>/dev/null || true)"
        [ "$comm" = "steam" ] || continue
        pid="$(basename "$dir")"
        envfile="${dir}/environ"
        kind="native"
        if tr '\0' '\n' < "$envfile" 2>/dev/null | grep -q "^FLATPAK_ID=${FLATPAK_APP}$"; then
            kind="flatpak"
        fi
        # a sandboxed process may hide its environment even from the same user
        if ! env_text="$(tr '\0' '\n' < "$envfile" 2>/dev/null)"; then
            has="unknown"
        elif printf '%s\n' "$env_text" | grep -qF "${ENV_NAME}=${GUID}"; then
            has="yes"
        else
            has="no"
        fi
        printf '%s %s %s\n' "$pid" "$kind" "$has"
    done
    return 0
}

# Last "SDL Mapping for 2dc8/301c" line of Steam's controller log.
last_logged_mapping() {
    local log="${1}/logs/controller.txt"
    [ -f "$log" ] || return 0
    grep 'SDL Mapping for 2dc8/301c:' "$log" | tail -1
}

# Lines "kind handler uniq" for every 8BitDo pad seen by the input layer — any
# number of them; uniq is the receiver serial (the BT address over Bluetooth).
# Only devices with a jsN handler are pads: in XInput mode the receiver also
# brings a keyboard and a mouse with the same IDs.
connected_pads() {
    [ -r "$INPUT_DEVICES" ] || return 0
    local mode handler uniq serial
    while read -r mode handler uniq; do
        # xpad reports no uniq; the USB device above the interface has the serial
        if [ "$uniq" = "-" ]; then
            serial="${SYS_DIR}/class/input/${handler}/device/device/../serial"
            [ -r "$serial" ] && uniq="$(cat "$serial")"
        fi
        printf '%s %s %s\n' "$mode" "$handler" "${uniq:--}"
    done < <(awk '
        /^I:/ {
            bus = ""; product = ""; uniq = "-"
            for (i = 2; i <= NF; i++) {
                split($i, kv, "=")
                if (kv[1] == "Bus") bus = kv[2]
                if (kv[1] == "Vendor") vendor = kv[2]
                if (kv[1] == "Product") product = kv[2]
            }
        }
        /^U:/ { sub(/^U: Uniq=/, ""); if ($0 != "") uniq = $0 }
        /^H:/ && vendor == "2dc8" {
            ev = ""; js = 0
            sub(/^Handlers=/, "", $2)
            for (i = 2; i <= NF; i++) {
                if ($i ~ /^event[0-9]+$/) ev = $i
                if ($i ~ /^js[0-9]+$/) js = 1
            }
            if (ev == "" || !js) next
            if (product == "301c" && bus == "0003") print "dinput " ev " " uniq
            else if (product == "310a") print "xinput " ev " " uniq
            else if (product == "301b") print "bt " ev " " uniq
            vendor = ""
        }
    ' "$INPUT_DEVICES")
}

# ---------------------------------------------------------------------------
# Changing state
# ---------------------------------------------------------------------------

dry_note() {
    printf '%s%s%s\n' "$C_DIM" "$*" "$C_OFF"
}

write_envd() {
    if [ "$DRY_RUN" -eq 1 ]; then
        dry_note "$(msg on_envd "$ENVD_FILE")"
        return 0
    fi
    mkdir -p "$(dirname "$ENVD_FILE")"
    cat > "$ENVD_FILE" <<EOF
# Created by ${PROGRAM} ${VERSION}. Removed by: ${PROGRAM} off
# 8BitDo Ultimate 2C Wireless over the 2.4 GHz receiver in DInput mode
# (2dc8:301c): L4/R4 as Steam Input back buttons (paddle2/paddle1).
${ENV_NAME}="${MAPPING}"
EOF
}

set_user_manager_env() {
    if [ "$DRY_RUN" -eq 1 ]; then
        dry_note "$(msg on_sysenv "$ENV_NAME")"
        return 0
    fi
    "$SYSTEMCTL" --user set-environment "${ENV_NAME}=${MAPPING}" 2>/dev/null \
        || note "$(msg sysenv_failed "$PROGRAM")"
}

unset_user_manager_env() {
    if [ "$DRY_RUN" -eq 1 ]; then
        dry_note "$(msg off_sysenv "$ENV_NAME")"
        return 0
    fi
    "$SYSTEMCTL" --user unset-environment "$ENV_NAME" 2>/dev/null \
        || note "$(msg sysenv_failed "$PROGRAM")"
}

# Drops a key from one section of the override file, an emptied section with
# it, and the whole file when nothing is left — the state before "on".
keyfile_drop_key() {
    local file="$1" section="$2" key="$3" tmp
    tmp="$(mktemp)"
    awk -v s="[$section]" -v k="$key" '
        /^\[/ { in_s = ($0 == s) }
        in_s && index($0, k "=") == 1 { next }
        { print }
    ' "$file" > "$tmp"
    awk '
        /^\[/ { if (header != "" && body != "") printf "%s%s", header, body
                header = $0 "\n"; body = ""; next }
        /^[[:space:]]*$/ { next }
        { body = body $0 "\n" }
        END { if (header != "" && body != "") printf "%s%s", header, body }
    ' "$tmp" > "$file"
    rm -f "$tmp"
    [ -s "$file" ] || rm -f "$file"
}

# Removes our variable from [Context] unset-environment=A;B; — left there by an
# earlier "flatpak override --unset-env", it would cancel the value we set.
drop_from_unset_list() {
    local file="$FLATPAK_OVERRIDE" list rest tmp
    list="$(keyfile_get "$file" Context unset-environment)"
    rest="$(printf '%s' "$list" | tr ';' '\n' | grep -vxF "$ENV_NAME" | grep -v '^$' | tr '\n' ';' || true)"
    if [ -z "$rest" ]; then
        keyfile_drop_key "$file" Context unset-environment
        return 0
    fi
    tmp="$(mktemp)"
    awk -v s="[Context]" -v v="unset-environment=${rest}" '
        /^\[/ { in_s = ($0 == s) }
        in_s && index($0, "unset-environment=") == 1 { print v; next }
        { print }
    ' "$file" > "$tmp"
    cat "$tmp" > "$file"
    rm -f "$tmp"
}

on_native() {
    case "$(target_state native)" in
        ours)    msg already_on "$PROGRAM" "$(msg native)"; printf '\n'; return 0 ;;
        foreign) die "$(msg refuse_foreign "$(msg native)" "$ENVD_FILE" "$ENV_NAME")" ;;
    esac
    write_envd
    set_user_manager_env
}

on_flatpak() {
    case "$(target_state flatpak)" in
        ours)
            if ! override_unset_listed; then
                msg already_on "$PROGRAM" "$(msg flatpak)"; printf '\n'; return 0
            fi ;;
        foreign) die "$(msg refuse_foreign "$(msg flatpak)" "$FLATPAK_OVERRIDE" "$ENV_NAME")" ;;
    esac
    if override_unset_listed; then
        if [ "$DRY_RUN" -eq 1 ]; then
            dry_note "$(msg on_unset_fix "$ENV_NAME" "$FLATPAK_OVERRIDE")"
        else
            drop_from_unset_list
        fi
    fi
    if [ "$DRY_RUN" -eq 1 ]; then
        dry_note "$(msg on_override "$ENV_NAME" "$FLATPAK_APP")"
        return 0
    fi
    "$FLATPAK" override --user --env="${ENV_NAME}=${MAPPING}" "$FLATPAK_APP"
}

off_native() {
    if [ ! -f "$ENVD_FILE" ]; then
        msg nothing_off "$PROGRAM" "$(msg native)"; printf '\n'
        return 0
    fi
    if [ "$DRY_RUN" -eq 1 ]; then
        dry_note "$(msg off_envd "$ENVD_FILE")"
    else
        rm -f "$ENVD_FILE"
    fi
    unset_user_manager_env
}

off_flatpak() {
    # only our own value is removed; somebody else's mapping stays where it is
    if [ "$(target_state flatpak)" != "ours" ]; then
        msg nothing_off "$PROGRAM" "$(msg flatpak)"; printf '\n'
        return 0
    fi
    if [ "$DRY_RUN" -eq 1 ]; then
        dry_note "$(msg off_override "$ENV_NAME" "$FLATPAK_OVERRIDE")"
        return 0
    fi
    keyfile_drop_key "$FLATPAK_OVERRIDE" Environment "$ENV_NAME"
}

# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------

cmd_status() {
    local list total=0 set=0 kind state shown verdict code
    list="$(targets)"
    for kind in $list; do
        total=$((total + 1))
        [ "$(target_state "$kind")" = "ours" ] && set=$((set + 1))
    done

    if [ "$total" -eq 0 ]; then
        verdict="${C_WARN}$(msg state_nosteam)${C_OFF}"; code=1
    elif [ "$set" -eq "$total" ]; then
        verdict="${C_OK}$(msg state_on)${C_OFF}"; code=0
    elif [ "$set" -eq 0 ]; then
        verdict="${C_WARN}$(msg state_off)${C_OFF}"; code=1
    else
        verdict="${C_BAD}$(msg state_partial "$set" "$total")${C_OFF}"; code=2
    fi

    printf '%s%s %s%s\n\n' "$C_HEAD" "$PROGRAM" "$VERSION" "$C_OFF"
    printf '  %s: %s\n' "$(msg head_state)" "$verdict"

    if [ "$total" -gt 0 ]; then
        printf '\n  %s%s%s\n' "$C_HEAD" "$(msg head_steam)" "$C_OFF"
        for kind in $list; do
            state="$(target_state "$kind")"
            case "$state" in
                ours)
                    if [ "$kind" = "native" ]; then shown="${C_OK}$(msg set_envd)${C_OFF}"
                    else shown="${C_OK}$(msg set_override)${C_OFF}"; fi ;;
                foreign) shown="${C_BAD}$(msg foreign)${C_OFF}" ;;
                *)       shown="${C_WARN}$(msg not_set)${C_OFF}" ;;
            esac
            printf '    %-9s %s\n              %s\n' "$(msg "$kind")" "$shown" \
                   "$(short_path "$(steam_dir "$kind")")"
            if [ "$kind" = "flatpak" ] && override_unset_listed; then
                printf '              %s%s%s\n' "$C_WARN" "$(msg unset_listed "$ENV_NAME")" "$C_OFF"
            fi
            if [ "$kind" = "native" ]; then
                local shadow
                shadow="$(shadowing_envd_file)"
                [ -n "$shadow" ] && printf '              %s%s%s\n' "$C_WARN" \
                    "$(msg shadowed "$shadow" "$ENV_NAME")" "$C_OFF"
            fi
        done
    fi

    printf '\n  %s%s%s\n' "$C_HEAD" "$(msg head_running)" "$C_OFF"
    local procs pid has
    procs="$(running_steam)"
    if [ -z "$procs" ]; then
        printf '    %s%s%s\n' "$C_DIM" "$(msg running_none)" "$C_OFF"
    else
        while read -r pid kind has; do
            if [ "$has" = "yes" ]; then
                printf '    %s%s%s\n' "$C_OK" "$(msg running_yes "$pid" "$(msg "$kind")")" "$C_OFF"
            elif [ "$has" = "unknown" ]; then
                printf '    %s%s%s\n' "$C_DIM" "$(msg running_unknown "$pid" "$(msg "$kind")")" "$C_OFF"
            else
                printf '    %s%s%s\n' "$C_WARN" "$(msg running_no "$pid" "$(msg "$kind")")" "$C_OFF"
            fi
        done <<< "$procs"
    fi

    if [ "$total" -gt 0 ]; then
        printf '\n  %s%s%s\n' "$C_HEAD" "$(msg head_log)" "$C_OFF"
        local line stamp
        for kind in $list; do
            line="$(last_logged_mapping "$(steam_dir "$kind")")"
            stamp="$(printf '%s' "$line" | sed -n 's/^\[\([^]]*\)\].*/\1/p')"
            if [ -z "$line" ]; then
                printf '    %s%s%s\n' "$C_DIM" "$(msg log_none "$(msg "$kind")")" "$C_OFF"
            elif [[ "$line" == *paddle1:* ]]; then
                printf '    %s%s%s\n' "$C_OK" "$(msg log_paddles "$(msg "$kind")" "$stamp")" "$C_OFF"
            else
                printf '    %s%s%s\n' "$C_WARN" "$(msg log_nopaddles "$(msg "$kind")" "$stamp")" "$C_OFF"
            fi
        done
    fi

    printf '\n  %s%s%s\n' "$C_HEAD" "$(msg head_pads)" "$C_OFF"
    local pads mode handler uniq count=0
    pads="$(connected_pads)"
    if [ -z "$pads" ]; then
        printf '    %s%s%s\n' "$C_DIM" "$(msg pad_none)" "$C_OFF"
    else
        while read -r mode handler uniq; do
            count=$((count + 1))
            case "$mode" in
                dinput) printf '    %s%s%s\n' "$C_OK" "$(msg pad_dinput "$handler")" "$C_OFF" ;;
                xinput) printf '    %s%s%s\n' "$C_WARN" "$(msg pad_xinput "$handler")" "$C_OFF" ;;
                bt)     printf '    %s\n' "$(msg pad_bt "$handler")" ;;
            esac
            printf '             %s%s %s%s\n' "$C_DIM" "$(msg serial)" "$uniq" "$C_OFF"
        done <<< "$pads"
        if [ "$count" -gt 1 ]; then
            printf '    %s%s%s\n' "$C_DIM" "$(msg pads_count "$count")" "$C_OFF"
        fi
    fi
    printf '\n'
    return "$code"
}

cmd_on() {
    local list kind
    list="$(targets)"
    [ -n "$list" ] || die "$(msg no_target)"
    for kind in $list; do
        "on_${kind}"
    done
    if [ "$DRY_RUN" -eq 0 ]; then
        msg done_on "$PROGRAM"; printf '\n'
    fi
}

cmd_off() {
    local list kind
    list="$(targets)"
    [ -n "$list" ] || die "$(msg no_target)"
    for kind in $list; do
        "off_${kind}"
    done
    if [ "$DRY_RUN" -eq 0 ]; then
        msg done_off "$PROGRAM"; printf '\n'
    fi
}

usage() {
    msg usage_title "$PROGRAM" "$VERSION"; printf '\n\n'
    msg usage_usage "$PROGRAM"; printf '\n\n'
    msg usage_commands; printf '\n'
    msg usage_status; printf '\n'
    msg usage_on "$ENV_NAME"; printf '\n'
    msg usage_off "$PROGRAM"; printf '\n'
    msg usage_mapping; printf '\n\n'
    msg usage_options; printf '\n'
    msg usage_target; printf '\n'
    msg usage_dry; printf '\n'
    msg usage_lang; printf '\n'
    msg usage_help; printf '\n'
    msg usage_version; printf '\n\n'
    msg usage_exit; printf '\n'
    msg usage_exit0; printf '\n'
    msg usage_exit1; printf '\n'
    msg usage_exit2; printf '\n\n'
    msg usage_req; printf '\n'
}

main() {
    local command=""
    while [ $# -gt 0 ]; do
        case "$1" in
            -n|--dry-run) DRY_RUN=1 ;;
            -t|--target)  shift; TARGET="${1:-}" ;;
            --target=*)   TARGET="${1#--target=}" ;;
            -l|--lang)    shift; LANGUAGE="$(detect_language "${1:-}")" ;;
            --lang=*)     LANGUAGE="$(detect_language "${1#--lang=}")" ;;
            -h|--help)    usage; return 0 ;;
            -V|--version) printf '%s %s\n' "$PROGRAM" "$VERSION"; return 0 ;;
            -*)           die "$(msg unknown_option "$1")" ;;
            *)
                [ -n "$command" ] && die "$(msg two_commands "$command" "$1")"
                command="$1"
                ;;
        esac
        shift
    done

    case "$TARGET" in
        ""|native|flatpak|all) ;;
        *) die "$(msg bad_target "$TARGET")" ;;
    esac

    case "${command:-status}" in
        status)                cmd_status ;;
        on|start|enable)       cmd_on ;;
        off|stop|disable)      cmd_off ;;
        mapping)               printf '%s\n' "$MAPPING" ;;
        *) die "$(msg unknown_command "$command")" ;;
    esac
}

main "$@"
