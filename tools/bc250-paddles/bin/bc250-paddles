#!/usr/bin/env bash
#
# bc250-paddles — L4/R4 of the 8BitDo Ultimate 2C Wireless as Steam Input back
# buttons over the 2.4 GHz receiver.
#
# In DInput mode the receiver (2dc8:301c) does send L4/R4 as their own buttons,
# but Steam builds an automatic SDL mapping without them and ignores (and
# overwrites) SDL_GamepadBind in config.vdf. A mapping passed in the
# SDL_GAMECONTROLLERCONFIG environment variable is honoured. This tool sets and
# removes that variable for native Steam (environment.d) and Flatpak Steam
# (a user override).

set -euo pipefail

readonly PROGRAM="bc250-paddles"
readonly VERSION="0.1.0"

readonly ENV_NAME="SDL_GAMECONTROLLERCONFIG"
readonly GUID="03000000c82d00001c30000011010000"
# Measured on the pad 1.06 / receiver 1.00: L4 = BTN_C = b2, R4 = BTN_Z = b5.
# crc:6fed is the CRC of the device name; without it Steam's own mapping wins.
readonly MAPPING="${GUID},8BitDo Ultimate 2C Wireless Controller,crc:6fed,a:b0,b:b1,back:b10,dpdown:h0.4,dpleft:h0.8,dpright:h0.2,dpup:h0.1,guide:b12,leftshoulder:b6,leftstick:b13,lefttrigger:a5,leftx:a0,lefty:a1,paddle1:b5,paddle2:b2,rightshoulder:b7,rightstick:b14,righttrigger:a4,rightx:a2,righty:a3,start:b11,x:b3,y:b4,platform:Linux,"
readonly FLATPAK_APP="com.valvesoftware.Steam"

# Test hook-in points. They are not set by hand in normal use.
FLATPAK="${BC250_PADDLES_FLATPAK:-flatpak}"
SYSTEMCTL="${BC250_PADDLES_SYSTEMCTL:-systemctl}"
PROC_DIR="${BC250_PADDLES_PROC:-/proc}"
INPUT_DEVICES="${BC250_PADDLES_INPUT_DEVICES:-/proc/bus/input/devices}"
SYS_DIR="${BC250_PADDLES_SYS:-/sys}"

CONFIG_HOME="${XDG_CONFIG_HOME:-${HOME}/.config}"
readonly ENVD_FILE="${CONFIG_HOME}/environment.d/90-${PROGRAM}.conf"
readonly NATIVE_STEAM="${HOME}/.local/share/Steam"
readonly FLATPAK_STEAM="${HOME}/.var/app/${FLATPAK_APP}/.local/share/Steam"
readonly FLATPAK_OVERRIDE="${FLATPAK_USER_DIR:-${HOME}/.local/share/flatpak}/overrides/${FLATPAK_APP}"

DRY_RUN=0
TARGET=""

# --------------------------------------------------------------------------
# Translations
# --------------------------------------------------------------------------

